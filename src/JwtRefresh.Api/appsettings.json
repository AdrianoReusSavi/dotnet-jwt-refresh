{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "RefreshToken": {
    "Lifetime": "7.00:00:00",
    "SessionLifetime": "30.00:00:00"
  },
  "AccessToken": {
    "Issuer": "jwt-refresh-api",
    "Audience": "jwt-refresh-clients",
    "Lifetime": "00:15:00"
  },
  "RateLimiting": {
    "PermitLimit": 5,
    "Window": "00:01:00"
  }
}
